%% =====================================================================
%%  thesis.sty — layout, packages, theorem environments and macros
%%  Check your graduate school's formatting guide and adjust the
%%  "LAYOUT" section (margins, spacing, page numbering) to match it.
%% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{thesis}[2026/09/25 Thesis style]

%% ---------------------------------------------------------------------
%%  Fonts and encoding
%% ---------------------------------------------------------------------
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{xfrac}
\IfFileExists{lmodern.sty}%
  {\RequirePackage{lmodern}\RequirePackage{microtype}}%
  {\RequirePackage[expansion=false]{microtype}}  % fallback for minimal TeX installs

%% ---------------------------------------------------------------------
%%  LAYOUT  (most grad schools: 1in margins, 1.5–2 line spacing)
%% ---------------------------------------------------------------------
\RequirePackage[letterpaper, margin=1in, left=1.25in]{geometry}  % 1.25in left for binding
\RequirePackage{setspace}
%\onehalfspacing
\doublespacing
\RequirePackage{fancyhdr}
\RequirePackage{emptypage}

%% ---------------------------------------------------------------------
%%  Mathematics
%% ---------------------------------------------------------------------
\RequirePackage{amsmath, amssymb, mathtools, bm}
\RequirePackage{amsthm}

%% ---------------------------------------------------------------------
%%  Figures, tables, algorithms
%% ---------------------------------------------------------------------
\RequirePackage{graphicx}
\graphicspath{{figures/}}
\RequirePackage{caption, subcaption}
\captionsetup{font=small, labelfont=bf}
\RequirePackage{booktabs}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta, positioning, bending, calc, shapes, backgrounds, fit}
\RequirePackage{algorithm, algpseudocode}
\RequirePackage[shortlabels]{enumitem}
\setlist{itemsep=2pt, topsep=4pt}
\RequirePackage{wrapfig}
%% ---------------------------------------------------------------------
%%  Bibliography (natbib: \citet{key} → "Author (Year)", \citep{key} → "(Author, Year)")
%% ---------------------------------------------------------------------
\RequirePackage[round, authoryear]{natbib}

%% ---------------------------------------------------------------------
%%  Draft mode and to-do notes
%% ---------------------------------------------------------------------
\newif\ifdraft
\draftfalse
\RequirePackage{xcolor}
\AtBeginDocument{%
  \ifdraft
    \fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\thepage}%
      \fancyfoot[R]{\scriptsize\color{gray}DRAFT \today}%
      \renewcommand{\headrulewidth}{0pt}}%
    \pagestyle{plain}%
  \else
    \pagestyle{plain}%
  \fi}
\RequirePackage[colorinlistoftodos, textsize=footnotesize]{todonotes}
\setlength{\marginparwidth}{0.9in}
\newcommand{\TODO}[1]{\ifdraft\todo[inline, color=orange!25]{#1}\fi}
\newcommand{\NOTE}[1]{\ifdraft\todo[color=blue!15]{#1}\fi}

%% ---------------------------------------------------------------------
%%  Hyperlinks (load late) and clever references (load after hyperref)
%% ---------------------------------------------------------------------
\RequirePackage[hidelinks, bookmarksnumbered]{hyperref}
\RequirePackage[capitalise, noabbrev]{cleveref}

%% ---------------------------------------------------------------------
%%  Theorem environments — numbered within chapter, one shared counter
%% ---------------------------------------------------------------------
%% Plain amsthm syntax (works on every TeX installation and editor).
%% Defined after cleveref is loaded, so \cref prints the right names.
\theoremstyle{plain}          % italic body: results
\newtheorem{theorem}{Theorem}[chapter]
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{corollary}[theorem]{Corollary}
\newtheorem{conjecture}[theorem]{Conjecture}
\theoremstyle{definition}     % upright body: definitions and assumptions
\newtheorem{definition}[theorem]{Definition}
\newtheorem{assumption}[theorem]{Assumption}
\newtheorem{example}[theorem]{Example}
\theoremstyle{remark}         % upright, lighter heading: remarks
\newtheorem{remark}[theorem]{Remark}

%% Names used by \cref / \Cref (cleveref knows most of these already;
%% set explicitly so every environment is labelled correctly)
\crefname{theorem}{Theorem}{Theorems}
\crefname{proposition}{Proposition}{Propositions}
\crefname{lemma}{Lemma}{Lemmas}
\crefname{corollary}{Corollary}{Corollaries}
\crefname{conjecture}{Conjecture}{Conjectures}
\crefname{definition}{Definition}{Definitions}
\crefname{assumption}{Assumption}{Assumptions}
\crefname{example}{Example}{Examples}
\crefname{remark}{Remark}{Remarks}
\numberwithin{equation}{chapter}
\numberwithin{figure}{chapter}
\numberwithin{table}{chapter}

%% "Proof of Theorem X" for proofs deferred to the appendix:
%%   \begin{proofof}{\cref{thm:main}} ... \end{proofof}
\newenvironment{proofof}[1]{\begin{proof}[Proof of #1]}{\end{proof}}

%% ---------------------------------------------------------------------
%%  Front/main/back matter for the report class
%% ---------------------------------------------------------------------
\newcommand{\frontmatter}{\cleardoublepage\pagenumbering{roman}}
\newcommand{\mainmatter}{\cleardoublepage\pagenumbering{arabic}}
\newcommand{\backmatter}{\cleardoublepage
  \addcontentsline{toc}{chapter}{Bibliography}}
\newcommand{\appendixmatter}{\cleardoublepage\appendix}

%% Unnumbered chapter that still appears in the table of contents
\newcommand{\frontchapter}[1]{%
  \chapter*{#1}\addcontentsline{toc}{chapter}{#1}\markboth{#1}{#1}}

%% ---------------------------------------------------------------------
%%  Title page
%% ---------------------------------------------------------------------
\def\@thesistitle{}\def\@thesisauthor{}\def\@thesisdegree{}
\def\@thesisfield{}\def\@thesisdepartment{}\def\@thesisuniversity{}
\def\@thesisdate{}\def\@thesisadvisor{}
\newcommand{\thesistitle}[1]{\def\@thesistitle{#1}\title{#1}}
\newcommand{\thesisauthor}[1]{\def\@thesisauthor{#1}\author{#1}}
\newcommand{\thesisdegree}[1]{\def\@thesisdegree{#1}}
\newcommand{\thesisfield}[1]{\def\@thesisfield{#1}}
\newcommand{\thesisdepartment}[1]{\def\@thesisdepartment{#1}}
\newcommand{\thesisuniversity}[1]{\def\@thesisuniversity{#1}}
\newcommand{\thesisdate}[1]{\def\@thesisdate{#1}}
\newcommand{\thesisadvisor}[1]{\def\@thesisadvisor{#1}}

\newcommand{\maketitlepage}{%
  \begin{titlepage}
    \begin{singlespace}
    \centering
    \vspace*{1in}
    {\LARGE\bfseries \@thesistitle\par}
    \vspace{0.6in}
    {\large by\par}\vspace{0.15in}
    {\Large \@thesisauthor\par}
    \vfill
    A dissertation submitted in partial fulfillment\\
    of the requirements for the degree of\\[0.1in]
    {\large \@thesisdegree}\\[0.1in]
    in \@thesisfield\\[0.3in]
    \@thesisdepartment\\
    \@thesisuniversity\\[0.3in]
    \@thesisdate
    \vfill
    Advisor: \@thesisadvisor
    \vspace*{0.5in}
    \end{singlespace}
  \end{titlepage}
  \setcounter{page}{2}}

